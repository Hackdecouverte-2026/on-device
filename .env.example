# Copy to .env and fill in the real values. This file is bundled into the
# binary at compile time, so any change requires a rebuild.
#
# ---------------------------------------------------------------------------
# Allowed proxy endpoints
# ---------------------------------------------------------------------------
# The proxy currently configured on the device must match one of these.
# One PROXY= line per endpoint. Scheme is required (http:// or https://).
# Additional lines may be named PROXY_<label>= to add more endpoints.
PROXY=http://192.0.2.1:8080
# PROXY_ALT=https://proxy2.example.com:3128

# ---------------------------------------------------------------------------
# Self-signature validation
# ---------------------------------------------------------------------------
# Ed25519 public key (hex, 64 chars) used to verify this binary's detached
# signature (<binary>.sig). Generate a keypair with:
#   cargo run --release --bin sign -- keygen
# then put the printed `public` value here, rebuild, and sign the binary.
# Leave empty to skip verification (development only).
SIGNING_PUBKEY=
